<Window x:Class="ElectronicsStore.LookupEditForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Запись"
        Height="220" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">
    <StackPanel  VerticalAlignment="Center">

        <TextBlock x:Name="HeaderText" Text="Название"
                   FontSize="18" 
                   Foreground="{StaticResource AppPrimary}"/>

        <TextBox x:Name="NameBox"
                 FontSize="18"
                 materialDesign:HintAssist.Hint="Введите название"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить"
                    Click="Save"
                    Background="{StaticResource AppPrimary}"
                    Foreground="White"/>
            <Button Content="Отмена"
                    Click="Cancel"
                    Background="#888"
                    Foreground="White"/>
        </StackPanel>

    </StackPanel>
</Window>